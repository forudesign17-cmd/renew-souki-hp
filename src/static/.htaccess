# ReNEW. — .htaccess
# 本番（https://renew-souki.jp）用。テスト環境では「https・wwwなしに統一」のブロックをコメントアウトする

RewriteEngine On

# 旧URL（STUDIO）→ 新URL（301）
# ※ https・wwwの統一より「先」に書き、転送先を https の完全なURLにしている。
#   http や www 付きで旧URLにアクセスされても、1回の転送で最終のURLに着く（検索エンジンに優しい）。
RewriteRule ^fullconstrution/?$ https://renew-souki.jp/menu/full/ [R=301,L]
RewriteRule ^subscription/?$ https://renew-souki.jp/menu/subscription/ [R=301,L]
RewriteRule ^qanda/?$ https://renew-souki.jp/faq/ [R=301,L]
RewriteRule ^(concept|menu|contact)$ https://renew-souki.jp/$1/ [R=301,L]

# https・wwwなしに統一
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://renew-souki.jp/$1 [R=301,L]

ErrorDocument 404 /404.html

# 文字コード・圧縮・キャッシュ
AddDefaultCharset UTF-8
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

# セキュリティ
Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
