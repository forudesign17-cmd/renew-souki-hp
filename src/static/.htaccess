# ReNEW. — .htaccess
# 本番（https://renew-souki.jp）用。テスト環境では「https・wwwなしに統一」のブロックをコメントアウトする

RewriteEngine On

# https・wwwなしに統一
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://renew-souki.jp/$1 [R=301,L]

# 旧URL（STUDIO）→ 新URL
RewriteRule ^fullconstrution/?$ /menu/full/ [R=301,L]
RewriteRule ^subscription/?$ /menu/subscription/ [R=301,L]
RewriteRule ^qanda/?$ /faq/ [R=301,L]
RewriteRule ^(concept|menu|contact)$ /$1/ [R=301,L]

ErrorDocument 404 /404.html

# 文字コード・圧縮・キャッシュ
AddDefaultCharset UTF-8
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

# セキュリティ
Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<Files "config.php">
  Require all denied
</Files>
